<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AffirmationsApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AffirmationsApp.styles.css" asp-append-version="true" />
</head>
<body>
    @if(User.Identity.IsAuthenticated){
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <ul style="display:flex; gap:15px; list-style:none;">
            <li><a asp-controller="Affirmations" asp-action="Index">Affirmations</a></li>
            <li><a asp-controller="Affirmations" asp-action="Random">Random Affirmation</a></li>
            @if(User.HasClaim("Permission", "Affirmations.Edit"))
            {
                <li><a asp-controller="Categories" asp-action="Index">Categories</a></li>
            }
            @if(User.HasClaim("Permission", "Admin.Access"))
            {
                <li><a asp-controller="Admin" asp-action="Index">Admin</a></li>
            }
            @if(User.HasClaim("Permission", "Admin.Access"))
            {
                <li>
                </li>
            }
            </ul>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <span class="nav-link">
                        Hello, @User.Identity.Name
                    </span>
                </li>

                <li class="nav-item">
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link nav-link">
                            Logout
                        </button>
                    </form>
                </li>
            </ul>
        </nav>
    </header>
    } else 
    {
           <div></div> 
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AffirmationsApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
