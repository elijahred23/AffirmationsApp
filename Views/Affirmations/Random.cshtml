@model Affirmation
<h2>Your Random Affirmation</h2>


@if (Model != null)
{
    <div style="border:1px solid #ccc; padding:20px; margin-top:10px;">
        <h3>@Model.Text</h3>
        <p><strong>Category:</strong> @Model.Category?.Name</p>
        <p><strong>Mood:</strong> @Model.Mood</p>
        <p><strong>Author:</strong> @Model.Author</p>
    </div>
    <br />
    <a asp-action="Random">Try Another</a>
}