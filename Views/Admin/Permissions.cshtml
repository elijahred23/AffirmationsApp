@model List<UserPermissionViewModel>
<h2>Permission Management</h2>

@foreach (UserPermissionViewModel user in Model)
{
    <div style="border:1px solid #ddd; padding:10px; margin-bottom:10px;">
        <h4>@user.Username</h4>

        @foreach (PermissionItemViewModel perm in user.Permissions)
        {
            <form method="post" asp-action="TogglePermission" style="display:inline;">
                <input type="hidden" name="userId" value="@user.UserId" />
                <input type="hidden" name="permissionId" value="@perm.PermissionId" />
                <label>
                    <input type="checkbox"
                        onchange="this.form.submit()"
                        @(perm.IsAssigned ? "checked" :"") />
                        @perm.Name
                </label>

            </form>
        }
    </div>
}